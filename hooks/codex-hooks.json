{
  "description": "Codex lifecycle hooks for TPA's local git guardrails.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/git-guardrails.sh\"",
            "timeout": 30,
            "statusMessage": "Checking Git guardrails"
          }
        ]
      }
    ]
  }
}
